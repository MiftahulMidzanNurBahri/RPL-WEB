# PostgreSQL connection string. On Railway, reference the PostgreSQL service's DATABASE_URL.
DATABASE_URL="postgresql://postgres:password@localhost:5432/lost_and_found?schema=public"

# Used by the API in a later implementation step; replace with a random secret locally.
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
API_PORT=3000
WEB_ORIGIN="http://localhost:5173"
UPLOAD_DIR="uploads"
# Shared cookie contract for the current local target. Vite derives VITE_CSRF_COOKIE_NAME.
CSRF_COOKIE_NAME="laf_csrf"
