# Prisma resolves this SQLite path relative to apps/api/prisma/schema.prisma.
DATABASE_URL="file:../../../data/lost-and-found.db"

# Used by the API in a later implementation step; replace with a random secret locally.
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
API_PORT=3000
WEB_ORIGIN="http://localhost:5173"
UPLOAD_DIR="uploads"