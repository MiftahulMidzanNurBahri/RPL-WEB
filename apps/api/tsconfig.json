{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "../..",
    "outDir": "../../dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "../../packages/shared/src/**/*.ts"]
}