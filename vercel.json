{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/src/server.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "apps/api/prisma/**",
          "apps/api/src/generated/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api(.*)",
      "dest": "apps/api/src/server.ts"
    },
    {
      "src": "/uploads(.*)",
      "dest": "apps/api/src/server.ts"
    }
  ]
}
